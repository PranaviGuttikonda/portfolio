---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Experience from '../islands/Experience.tsx';
import { jobs } from '../data/experience';
---

<BaseLayout>
  <Hero />

  <section id="experience" class="section container">
    <SectionHeading num="01." title="Where I've worked" />
    <!-- client:idle, not :visible: hydrated before anyone scrolls here, so early clicks work. -->
    <Experience client:idle jobs={jobs} />
  </section>

  <section id="projects" class="section container">
    <SectionHeading num="02." title="Things I've built" />
  </section>

  <section id="skills" class="section container">
    <SectionHeading num="03." title="Toolbox" />
  </section>

  <section id="contact" class="section container"></section>
</BaseLayout>

<style>
  .section {
    min-height: 40vh;
  }
</style>
