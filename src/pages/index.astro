---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Experience from '../islands/Experience.tsx';
import { jobs } from '../data/experience';
import Projects from '../islands/Projects.tsx';
import OtherProjects from '../components/OtherProjects.astro';
import { featured } from '../data/projects';
---

<BaseLayout>
  <Hero />

  <section id="experience" class="section container">
    <SectionHeading num="01." title="Where I've worked" />
    <!-- client:idle, not :visible: hydrated before anyone scrolls here, so early clicks work. -->
    <Experience client:idle jobs={jobs} />
  </section>

  <section id="projects" class="section container">
    <SectionHeading num="02." title="Things I've built" />
    <p class="section-intro">
      Pick a project to see what it does and how it's built. quorum runs live, so try crashing its
      leader.
    </p>
    <!-- client:idle for the same reason as Experience: ready before anyone scrolls here. -->
    <Projects client:idle projects={featured} />
    <OtherProjects />
  </section>

  <section id="skills" class="section container">
    <SectionHeading num="03." title="Toolbox" />
  </section>

  <section id="contact" class="section container"></section>
</BaseLayout>

<style>
  .section {
    min-height: 40vh;
  }

  .section-intro {
    max-width: 640px;
    margin: -16px 0 32px;
    font-size: 17px;
    color: var(--muted);
  }
</style>
