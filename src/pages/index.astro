---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
---

<BaseLayout>
  <!-- Hero and chat land in Phase 2. -->
  <section class="hero dot-grid">
    <div class="container">
      <h1>
        hi, I'm <span class="nowrap"><span class="accent">Pranavi</span>.<span
            class="cursor"
            aria-hidden="true"></span></span>
      </h1>
    </div>
  </section>

  <section id="experience" class="section container">
    <SectionHeading num="01." title="Where I've worked" />
  </section>

  <section id="projects" class="section container">
    <SectionHeading num="02." title="Things I've built" />
  </section>

  <section id="skills" class="section container">
    <SectionHeading num="03." title="Toolbox" />
  </section>

  <section id="contact" class="section container"></section>
</BaseLayout>

<style>
  .hero {
    padding-block: 120px;
  }

  .hero h1 {
    font-size: clamp(44px, 8vw, 76px);
    letter-spacing: -0.04em;
  }

  .accent {
    color: var(--accent);
  }

  /* Given: "Pranavi." and the cursor must never split across lines.
     Approach: wrap them together in a no-wrap span. */
  .nowrap {
    white-space: nowrap;
  }

  /* Given: a terminal-style cursor after the name.
     Approach: an empty inline-block bar; its bottom edge sits on the text baseline.
     steps(1) makes the blink a hard on/off, 0.5s each. */
  .cursor {
    display: inline-block;
    width: 0.08em;
    height: 0.85em;
    margin-left: 0.12em;
    vertical-align: baseline;
    background: var(--accent);
    animation: cursor-blink 1s steps(1) infinite;
  }

  @keyframes cursor-blink {
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor {
      animation: none;
    }
  }

  .section {
    min-height: 40vh;
  }
</style>
