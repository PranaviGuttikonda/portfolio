---
import { education } from '../data/education';
---

<div class="edu">
  <h3 class="edu__label" id="education">EDUCATION</h3>
  <ul class="edu__grid" aria-labelledby="education">
    {
      education.map((d) => (
        <li class="card edu__card">
          <div class="edu__head">
            <p class="edu__school">
              {d.school}
              {d.unit && <span class="edu__unit">, {d.unit}</span>}
            </p>
            <p class="edu__dates">{d.dates}</p>
          </div>
          <p class="edu__degree">{d.degree}</p>
          <ul class="edu__details">
            {d.details.map((line) => (
              <li>{line}</li>
            ))}
          </ul>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .edu {
    margin-top: 48px;
  }

  .edu__label {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--accent);
  }

  .edu__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin-top: 16px;
    padding: 0;
    list-style: none;
  }

  .edu__card {
    padding: 22px 24px;
  }

  .edu__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 4px 16px;
  }

  .edu__school {
    font-family: var(--font-heading);
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .edu__unit {
    color: var(--muted);
    font-weight: 500;
  }

  .edu__dates {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--muted);
    white-space: nowrap;
  }

  .edu__degree {
    margin-top: 4px;
    font-size: 15.5px;
    color: var(--accent);
  }

  .edu__details {
    display: grid;
    gap: 6px;
    margin-top: 12px;
    padding: 0;
    list-style: none;
  }

  .edu__details li {
    position: relative;
    padding-left: 22px;
    font-size: 14.5px;
    color: var(--text-2);
  }

  .edu__details li::before {
    content: '▹';
    position: absolute;
    left: 0;
    color: var(--accent);
  }

  @media (max-width: 767px) {
    .edu__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
