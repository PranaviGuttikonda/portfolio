---
import { others } from '../data/projects';
---

<div class="others">
  <h3 class="others__label">OTHER PROJECTS</h3>
  <ul class="others__grid">
    {
      others.map((o) => (
        <li class="card card--hover others__card">
          <h4 class="others__name">
            {o.code ? (
              <a href={o.code} target="_blank" rel="noopener noreferrer">
                {o.name}
              </a>
            ) : (
              o.name
            )}
          </h4>
          <p class="others__line">{o.line}</p>
          <p class="others__stack">{o.stack}</p>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .others {
    margin-top: 64px;
  }

  .others__label {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--accent);
  }

  .others__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 16px;
    margin-top: 18px;
    padding: 0;
    list-style: none;
  }

  .others__card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 22px 22px 20px;
  }

  .others__name {
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .others__name a:hover {
    color: var(--accent);
  }

  .others__line {
    flex: 1;
    font-size: 14.5px;
    color: var(--text-2);
  }

  .others__stack {
    margin-top: 6px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--muted);
  }
</style>
