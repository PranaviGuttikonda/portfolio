---
import Chatbot from '../islands/Chatbot.tsx';
import Cursor from './Cursor.astro';
import SocialLinks from './SocialLinks.astro';
import { site } from '../data/site';
---

<section class="hero dot-grid" aria-labelledby="hero-title">
  <div class="hero__glow" aria-hidden="true"></div>

  <div class="container hero__inner">
    <div class="hero__grid">
      <div class="hero__intro">
        <p class="hero__badge">
          <span class="hero__pulse" aria-hidden="true"></span>
          Open to Summer 2027 internships &amp; co-ops
        </p>

        <h1 id="hero-title" class="hero__title">
          hi, I'm <span class="hero__nowrap"><span class="hero__accent">Pranavi</span>.<Cursor /></span>
        </h1>

        <p class="hero__lede">
          Software engineer in Boston, working on backend and distributed systems.
        </p>

        <div class="hero__actions">
          <a href="#experience" class="btn btn--accent">See my work →</a>
          <a href={site.resume} class="btn btn--outline" download>Resume ↓</a>
          <SocialLinks size="lg" />
        </div>
      </div>

      <div class="hero__chat">
        <Chatbot client:load />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: 88px;
  }

  /* Given: two soft glows, accent near the top-right and a faint teal near the bottom-left.
     Approach: one absolutely placed layer with two radial gradients, behind the content. */
  .hero__glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(
        600px circle at 88% 8%,
        color-mix(in srgb, var(--accent) 14%, transparent),
        transparent 70%
      ),
      radial-gradient(
        520px circle at 6% 96%,
        color-mix(in srgb, #2dd4bf 8%, transparent),
        transparent 70%
      );
  }

  .hero__inner {
    position: relative;
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    align-items: center;
    gap: 56px;
  }

  /* ---------- Left column ---------- */
  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 14px 6px 12px;
    border-radius: 999px;
    border: 1px solid var(--border-strong);
    background: var(--surface);
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-2);
  }

  .hero__pulse {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--success);
  }

  .hero__pulse::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--success);
    animation: hero-pulse 1.8s ease-out infinite;
  }

  @keyframes hero-pulse {
    from {
      transform: scale(1);
      opacity: 0.7;
    }
    to {
      transform: scale(2.8);
      opacity: 0;
    }
  }

  .hero__title {
    margin-top: 28px;
    font-size: clamp(44px, 6.4vw, 76px);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.045em;
  }

  .hero__accent {
    color: var(--accent);
  }

  /* "Pranavi." and the cursor wrap together, never apart. */
  .hero__nowrap {
    white-space: nowrap;
  }

  .hero__lede {
    max-width: 560px;
    margin-top: 24px;
    font-size: 19px;
    line-height: 1.65;
    color: var(--muted);
  }

    .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-top: 36px;
  }

  /* ---------- Right column ---------- */
  .hero__chat {
    width: 100%;
    max-width: 480px;
    justify-self: end;
  }

  /* ---------- Tablet and below: stack ---------- */
  @media (max-width: 959px) {
    .hero {
      padding-block: 56px 64px;
    }

    .hero__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 48px;
    }

    .hero__chat {
      max-width: 560px;
      justify-self: stretch;
    }

  }

  @media (max-width: 479px) {
    .hero__badge {
      gap: 8px;
      padding-inline: 10px 12px;
      font-size: 11.5px;
    }

    .hero__lede {
      font-size: 17px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__pulse::after {
      animation: none;
    }
  }
</style>
