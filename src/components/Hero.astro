---
import Chatbot from '../islands/Chatbot.tsx';
import { site } from '../data/site';

const facts = [
  { label: 'PREVIOUSLY', value: 'GoQuant · DeepEdge · Isaksai' },
  { label: 'STUDYING', value: 'MS CS · Northeastern University' },
  { label: 'FOCUS', value: 'Backend · distributed systems · C++' },
  { label: 'BASED IN', value: 'Boston, MA' },
];
---

<section class="hero dot-grid" aria-labelledby="hero-title">
  <div class="hero__glow" aria-hidden="true"></div>

  <div class="container hero__inner">
    <div class="hero__grid">
      <div class="hero__intro">
        <p class="hero__badge">
          <span class="hero__pulse" aria-hidden="true"></span>
          Open to Summer 2027 internships &amp; co-ops
        </p>

        <h1 id="hero-title" class="hero__title">
          hi, I'm <span class="hero__nowrap"><span class="hero__accent">Pranavi</span>.<span
              class="hero__cursor"
              aria-hidden="true"></span></span>
        </h1>

        <p class="hero__lede">
          Software engineer in Boston. I spent the last year and a half building exchange
          integrations and debugging trading systems at <strong>GoQuant</strong>. Now I'm doing
          my MS in CS at <strong>Northeastern</strong>, and building things on the side.
        </p>

        <div class="hero__actions">
          <a href="#experience" class="btn btn--accent">See my work →</a>
          <a href={site.resume} class="btn btn--outline">Resume ↓</a>
          <a
            href={site.github}
            class="icon-btn hero__icon"
            aria-label="GitHub"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path
                d="M12 .5C5.65.5.5 5.65.5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.87-1.37-3.87-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.76 2.69 1.25 3.35.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.69 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"
              ></path>
            </svg>
          </a>
          <a
            href={site.linkedin}
            class="icon-btn hero__icon"
            aria-label="LinkedIn"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path
                d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"
              ></path>
            </svg>
          </a>
        </div>
      </div>

      <div class="hero__chat">
        <Chatbot client:load />
      </div>
    </div>

    <dl class="hero__facts">
      {
        facts.map((f) => (
          <div class="hero__fact">
            <dt>{f.label}</dt>
            <dd>{f.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: 88px 56px;
  }

  /* Given: two soft glows, accent near the top-right and a faint teal near the bottom-left.
     Approach: one absolutely placed layer with two radial gradients, behind the content. */
  .hero__glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(
        600px circle at 88% 8%,
        color-mix(in srgb, var(--accent) 14%, transparent),
        transparent 70%
      ),
      radial-gradient(
        520px circle at 6% 96%,
        color-mix(in srgb, #2dd4bf 8%, transparent),
        transparent 70%
      );
  }

  .hero__inner {
    position: relative;
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    align-items: center;
    gap: 56px;
  }

  /* ---------- Left column ---------- */
  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 14px 6px 12px;
    border-radius: 999px;
    border: 1px solid var(--border-strong);
    background: var(--surface);
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-2);
  }

  .hero__pulse {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--success);
  }

  .hero__pulse::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--success);
    animation: hero-pulse 1.8s ease-out infinite;
  }

  @keyframes hero-pulse {
    from {
      transform: scale(1);
      opacity: 0.7;
    }
    to {
      transform: scale(2.8);
      opacity: 0;
    }
  }

  .hero__title {
    margin-top: 28px;
    font-size: clamp(44px, 6.4vw, 76px);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.045em;
  }

  .hero__accent {
    color: var(--accent);
  }

  /* "Pranavi." and the cursor wrap together, never apart. */
  .hero__nowrap {
    white-space: nowrap;
  }

  /* Given: a terminal-style cursor after the name.
     Approach: an empty inline-block bar; its bottom edge sits on the text baseline.
     steps(1) makes the blink a hard on/off, 0.5s each. */
  .hero__cursor {
    display: inline-block;
    width: 0.08em;
    height: 0.85em;
    margin-left: 0.12em;
    vertical-align: baseline;
    background: var(--accent);
    animation: cursor-blink 1s steps(1) infinite;
  }

  @keyframes cursor-blink {
    50% {
      opacity: 0;
    }
  }

  .hero__lede {
    max-width: 560px;
    margin-top: 24px;
    font-size: 19px;
    line-height: 1.65;
    color: var(--muted);
  }

  .hero__lede strong {
    font-weight: 600;
    color: var(--text);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-top: 36px;
  }

  .hero__icon {
    width: 50px;
    height: 50px;
    color: var(--text);
  }

  .hero__icon svg {
    width: 20px;
    height: 20px;
  }

  /* ---------- Right column ---------- */
  .hero__chat {
    width: 100%;
    max-width: 480px;
    justify-self: end;
  }

  /* ---------- Quick facts ---------- */
  .hero__facts {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
    margin-top: 72px;
    padding-top: 28px;
    border-top: 1px solid var(--border);
  }

  .hero__fact dt {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--accent);
  }

  .hero__fact dd {
    margin-top: 6px;
    font-size: 15px;
    color: var(--text-2);
  }

  /* ---------- Tablet and below: stack ---------- */
  @media (max-width: 959px) {
    .hero {
      padding-block: 56px 48px;
    }

    .hero__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 48px;
    }

    .hero__chat {
      max-width: 560px;
      justify-self: stretch;
    }

    .hero__facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      margin-top: 56px;
    }
  }

  @media (max-width: 479px) {
    .hero__badge {
      gap: 8px;
      padding-inline: 10px 12px;
      font-size: 11.5px;
    }

    .hero__lede {
      font-size: 17px;
    }

    .hero__facts {
      gap: 20px 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__cursor,
    .hero__pulse::after {
      animation: none;
    }
  }
</style>
