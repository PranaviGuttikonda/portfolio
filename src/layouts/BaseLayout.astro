---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
import { Font } from 'astro:assets';
import ThemeScript from '../components/ThemeScript.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CommandPalette from '../islands/CommandPalette.tsx';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { title = site.title, description = site.description, noindex = false } = Astro.props;

// Given: one site URL (astro.config.mjs `site`).
// Approach: every absolute URL on the page is built from it.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og-image.png', Astro.site).href;

// Vercel sets VERCEL=1 during its builds; local builds leave analytics out.
const onVercel = process.env.VERCEL === '1';
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#0B1220" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#EDEBE5" media="(prefers-color-scheme: light)" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Pranavi Guttikonda, software engineer in Boston" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Runs before paint so the saved/OS theme is applied with no flash. -->
    <ThemeScript />

    <!-- Self-hosted fonts; preload only the weights seen above the fold. -->
    <Font cssVariable="--font-inter" preload={[{ weight: 400 }]} />
    <Font cssVariable="--font-space-grotesk" preload={[{ weight: 600 }]} />
    <Font cssVariable="--font-jetbrains-mono" preload={[{ weight: 500 }]} />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <CommandPalette client:idle />
    {onVercel && <Analytics />}
  </body>
</html>
